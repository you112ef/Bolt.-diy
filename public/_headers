# Cache manifest.json for a short period, encouraging browser to revalidate
/manifest.json
  Cache-Control: max-age=3600, stale-while-revalidate=86400

# Service worker should not be cached aggressively by HTTP cache,
# as it has its own update mechanism.
# Service-Worker-Allowed header ensures it can control the root scope.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /

# Cache icons and other static assets for a long time
/icons/*
  Cache-Control: public, max-age=31536000, immutable
/apple-touch-icon.png
  Cache-Control: public, max-age=31536000, immutable
/apple-touch-icon-precomposed.png
  Cache-Control: public, max-age=31536000, immutable
/favicon.ico
  Cache-Control: public, max-age=31536000, immutable
/favicon.svg
  Cache-Control: public, max-age=31536000, immutable
/logo.svg
  Cache-Control: public, max-age=31536000, immutable

# Built assets (JS, CSS) are typically fingerprinted, so they can be cached aggressively.
# This pattern might need adjustment based on Remix's actual build output structure.
# Cloudflare Pages often handles this well by default for fingerprinted assets.
#/build/_assets/*
#  Cache-Control: public, max-age=31536000, immutable

